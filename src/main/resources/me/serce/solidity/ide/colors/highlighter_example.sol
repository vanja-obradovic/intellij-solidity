<KEYWORD>pragma</KEYWORD> <KEYWORD>solidity</KEYWORD> ^0.4.11;

<KEYWORD>import</KEYWORD> "./Ownable.sol";

<TYPE>uint8</TYPE> <KEYWORD>constant</KEYWORD> <CONSTANT>MASK</CONSTANT> = 0x01;

<KEYWORD>enum</KEYWORD> <ENUM_NAME>Types</ENUM_NAME> {
    <ENUM_VALUE>Type1</ENUM_VALUE>,
    <ENUM_VALUE>Type2</ENUM_VALUE>
}

<KEYWORD>type</KEYWORD> <USER_DEFINED_VALUE_TYPE>Arg</USER_DEFINED_VALUE_TYPE> <KEYWORD>is</KEYWORD> <TYPE>uint256</TYPE>;

<KEYWORD>interface</KEYWORD> <INTERFACE_NAME>ERC20Basic</INTERFACE_NAME> {}

<KEYWORD>library</KEYWORD> <LIBRARY_NAME>Address</LIBRARY_NAME> {}

/**
 * @title Claimable
 * @dev Extension for the Ownable contract, where the ownership needs to be claimed.
 * This allows the new owner to accept the transfer.
 */
<KEYWORD>contract</KEYWORD> <CONTRACT_NAME>Claimable</CONTRACT_NAME> <KEYWORD>is</KEYWORD> <CONTRACT_NAME>Ownable</CONTRACT_NAME> {

    <KEYWORD>error</KEYWORD> <ERROR_NAME>InvalidAddress</ERROR_NAME>(<TYPE>address</TYPE> addr);

    <KEYWORD>event</KEYWORD> <EVENT_NAME>TokenTransfer</EVENT_NAME>(<TYPE>uint256</TYPE> tokenId, <TYPE>address</TYPE> recipient);

    <TYPE>bytes</TYPE> <KEYWORD>public</KEYWORD> <KEYWORD>constant</KEYWORD> <CONSTANT>DATA</CONSTANT> = <KEYWORD>hex</KEYWORD><STRING>"48656C6C6F2C20576F726C6421"</STRING>;
    <TYPE>address</TYPE> <KEYWORD>public</KEYWORD> <STATE_VARIABLE>pendingOwner</STATE_VARIABLE>;
    <TYPE>address</TYPE> <KEYWORD>public</KEYWORD> <KEYWORD>immutable</KEYWORD> <IMMUTABLE>deployer</IMMUTABLE>;

    <KEYWORD>struct</KEYWORD> <STRUCT_NAME>Struct</STRUCT_NAME> {
        <TYPE>bool</TYPE> <STRUCT_MEMBER>flag</STRUCT_MEMBER>;
        <TYPE>uint</TYPE> <STRUCT_MEMBER>count</STRUCT_MEMBER>;
    }

    <KEYWORD>modifier</KEYWORD> <MODIFIER>onlyPendingOwner</MODIFIER>() {
        <KEYWORD>require</KEYWORD>(<GLOBAL>msg</GLOBAL>.<BUILTIN_MEMBER>sender</BUILTIN_MEMBER> == <STATE_VARIABLE>pendingOwner</STATE_VARIABLE>);
        _;
    }

    <RECEIVE_FALLBACK_DECLARATION>receive</RECEIVE_FALLBACK_DECLARATION>() <KEYWORD>external</KEYWORD> <KEYWORD>payable</KEYWORD> {}
    <RECEIVE_FALLBACK_DECLARATION>fallback</RECEIVE_FALLBACK_DECLARATION>() <KEYWORD>external</KEYWORD> {}

    <KEYWORD>function</KEYWORD> <FUNCTION_DECLARATION>transferOwnership</FUNCTION_DECLARATION>(<TYPE>address</TYPE> <FUNCTION_PARAMETER>newOwner</FUNCTION_PARAMETER>) <MODIFIER>onlyOwner</MODIFIER> {
        <STATE_VARIABLE_WRITE><STATE_VARIABLE>pendingOwner</STATE_VARIABLE></STATE_VARIABLE_WRITE> = <FUNCTION_PARAMETER>newOwner</FUNCTION_PARAMETER>;
    }

    <KEYWORD>function</KEYWORD> <FUNCTION_DECLARATION>claimOwnership</FUNCTION_DECLARATION>() <MODIFIER>onlyPendingOwner</MODIFIER> {
        <STATE_VARIABLE_WRITE><STATE_VARIABLE>owner</STATE_VARIABLE></STATE_VARIABLE_WRITE> = <STATE_VARIABLE>pendingOwner</STATE_VARIABLE>;
        <STATE_VARIABLE_WRITE><STATE_VARIABLE>pendingOwner</STATE_VARIABLE></STATE_VARIABLE_WRITE> = 0x0;
    }

    <KEYWORD>function</KEYWORD> <FUNCTION_DECLARATION>reclaimToken</FUNCTION_DECLARATION>(<INTERFACE_NAME>ERC20Basic</INTERFACE_NAME> <FUNCTION_PARAMETER>token</FUNCTION_PARAMETER>) <KEYWORD>external</KEYWORD> <MODIFIER>onlyPendingOwner</MODIFIER> {
        <TYPE>uint256</TYPE> <LOCAL_VARIABLE>balance</LOCAL_VARIABLE> = <FUNCTION_PARAMETER>token</FUNCTION_PARAMETER>.<FUNCTION_CALL>balanceOf</FUNCTION_CALL>(<KEYWORD>this</KEYWORD>);
        <FUNCTION_PARAMETER>token</FUNCTION_PARAMETER>.<FUNCTION_CALL>transfer</FUNCTION_CALL>(<STATE_VARIABLE>pendingOwner</STATE_VARIABLE>, <LOCAL_VARIABLE>balance</LOCAL_VARIABLE> + <GLOBAL>block</GLOBAL>.<BUILTIN_MEMBER>timestamp</BUILTIN_MEMBER> + <GLOBAL_FUNCTION_CALL>gasleft</GLOBAL_FUNCTION_CALL>());
    }

    <KEYWORD>function</KEYWORD> <FUNCTION_DECLARATION>_setImplementation</FUNCTION_DECLARATION>(<KEYWORD>address</KEYWORD> <FUNCTION_PARAMETER>newImplementation</FUNCTION_PARAMETER>) <KEYWORD>private</KEYWORD> {
        <KEYWORD>require</KEYWORD>(<LIBRARY_NAME>Address</LIBRARY_NAME>.<FUNCTION_CALL>isContract</FUNCTION_CALL>(<FUNCTION_PARAMETER>newImplementation</FUNCTION_PARAMETER>), "ERC1967: new implementation is not a contract");

        <STRUCT_NAME>Struct</STRUCT_NAME> <KEYWORD>storage</KEYWORD> <STATE_VARIABLE>r</STATE_VARIABLE>;
        <KEYWORD>assembly</KEYWORD> {
            <KEYWORD>let</KEYWORD> <LOCAL_VARIABLE>slot</LOCAL_VARIABLE> := <YUL_BUILTIN>add</YUL_BUILTIN>(<CONSTANT>MASK</CONSTANT>, 1)
            r_slot := <LOCAL_VARIABLE>slot</LOCAL_VARIABLE>
        }
        <STATE_VARIABLE>r</STATE_VARIABLE>.<STRUCT_MEMBER>value</STRUCT_MEMBER> = <FUNCTION_PARAMETER>newImplementation</FUNCTION_PARAMETER>;
    }
}
